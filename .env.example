# Server
NOCOOS_PORT=3000
NOCOOS_HOST=0.0.0.0
NOCOOS_ENV=development

# Security (change for production)
NOCOOS_SESSION_SECRET=change-me-to-a-long-random-string

# Optional: limit terminal processes
NOCOOS_MAX_TERMINALS=8

# Optional: path for installed CLIs (default uses data/apps/.bin)
NOCOOS_APPS_DIR=

# Logging
NOCOOS_LOG_LEVEL=info       # debug | info | warn | error
NOCOOS_LOG_FORMAT=text      # text | json
NOCOOS_LOG_FILE=            # path to log file (optional)

# Hot Module Reload (frontend)
NOCOOS_HMR=0                # 1 to enable frontend HMR (auto-reload on file change)

